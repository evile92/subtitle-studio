# ==============================================================================
# SUBTITLE STUDIO — ENVIRONMENT CONFIGURATION (.env.example)
# Copy this file to .env.local and fill in your preferred AI provider API key.
# ==============================================================================

# 1. Configurable Application Name (Displayed in header & browser UI)
NEXT_PUBLIC_APP_NAME="Subtitle Studio"

# 2. Active AI Provider ("gemini" | "openai" | "anthropic" | "custom")
AI_PROVIDER="gemini"

# 3. Active AI Model Name
# Examples:
# - Gemini:    gemini-2.5-flash, gemini-2.5-pro
# - OpenAI:    gpt-4o, gpt-4o-mini, gpt-4.1
# - Anthropic: claude-3-5-sonnet-latest, claude-3-7-sonnet-latest
# - Custom:    deepseek-chat, llama-3.3-70b-versatile, qwen-2.5-72b-instruct
AI_MODEL="gemini-2.5-flash"

# 4. Provider API Keys (Server-Side Only — Never Exposed to Frontend)
GEMINI_API_KEY=""
OPENAI_API_KEY=""
ANTHROPIC_API_KEY=""

# 5. Optional Custom OpenAI-Compatible Endpoint (OpenRouter, DeepSeek, Groq, Local Ollama)
CUSTOM_AI_BASE_URL="https://api.openai.com/v1"
CUSTOM_AI_API_KEY=""

# 6. AI Generation Parameters
AI_TEMPERATURE="0.2"
AI_MAX_RETRIES="3"

# 7. Security, Upload & Retention Policy
MAX_UPLOAD_SIZE_MB="15"
JOB_RETENTION_HOURS="48"
RATE_LIMIT_MAX_REQUESTS="120"
